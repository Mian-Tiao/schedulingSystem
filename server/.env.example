# 伺服器埠號
PORT=3001

# 資料庫連線(Prisma)
# - 本機開發:用 SQLite 即可(預設,不需安裝任何資料庫)
# - 部署到 Render:設成 PostgreSQL 連線字串(Render 會自動注入),例如:
#   DATABASE_URL="postgresql://user:password@host:5432/dbname"
DATABASE_URL="file:./dev.db"

# Gemini API Key(選填;未設定時 AI 諮詢功能停用,核心排程功能不受影響)
GEMINI_API_KEY=

# Gemini 模型
GEMINI_MODEL=gemini-3.6-flash
